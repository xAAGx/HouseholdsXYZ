# Copy to .env (git-ignored). Read only by the repo scripts (`pnpm supabase`,
# `pnpm db:push`, `pnpm db:types`, `pnpm db:lint`, `pnpm geo:import`), never by
# the apps. Never copy these into apps/*/.env or Vercel, and never commit them.

# Supabase personal access token: dashboard → Account → Access Tokens.
# It can manage EVERY project in your Supabase account: give it an expiry date,
# and revoke it if this machine is lost or shared.
SUPABASE_ACCESS_TOKEN=

# The database password (the one set when creating the project). Full access to
# all data, bypassing Row Level Security. Used by `pnpm db:push`. If it leaks:
# Project Settings → Database → Reset database password.
SUPABASE_DB_PASSWORD=

# For `pnpm geo:import`: Supabase → Connect → Session pooler URI, with the
# password filled in (percent-encode special characters).
DATABASE_URL=
