# Copy to .env (git-ignored). PUBLIC VALUES ONLY: every VITE_* variable is embedded
# in the JavaScript bundle anyone can download. The dev server and build refuse to
# start if a secret/service_role key shows up here.

# From `pnpm db:start` (or Supabase dashboard → Project Settings → API).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# The Hono API (apps/server).
VITE_API_URL=http://127.0.0.1:8787
