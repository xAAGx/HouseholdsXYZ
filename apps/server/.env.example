# Copy to .env (git-ignored) for local development. Never commit real values.
# In Vercel, set these per environment in Project Settings → Environment Variables.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Same values as apps/web/.env (Supabase dashboard → Project Settings → API Keys).
SUPABASE_URL=https://<project-ref>.supabase.co
# The *publishable* key. The API acts as the signed-in user, so RLS always applies.
# A secret/service_role key here is rejected at startup.
SUPABASE_PUBLISHABLE_KEY=

# The *secret* key (sb_secret_…). Bypasses RLS, so it is used by exactly one module,
# src/lib/admin-auth.ts: child logins and deleting your own account. Leave empty to
# switch those off. Never put it anywhere else, and never in apps/web.
SUPABASE_SECRET_KEY=

# Exact web origins allowed to call the API, comma-separated. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5180

# Push notifications: set all four, or leave all empty (push off; the in-app
# inbox still works). Generate the VAPID pair once with
#   pnpm --filter @households/server exec web-push generate-vapid-keys
# and the seal key with
#   openssl rand -base64 32
# The private key and seal key are secrets: server env only, never apps/web.
# Changing the seal key turns notifications off on every device (people turn
# them on again in Account settings).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SEAL_KEY=

# Reminders (events, chores, bills, documents, allowances) are written by a
# timer in the database (pg_cron), which posts their pushes to /internal/push
# signed with this secret. Generate it with
#   openssl rand -hex 32
# and store the same value, plus this API's push URL, in Supabase Vault (SQL editor):
#   select vault.create_secret('<the secret>', 'households_push_secret');
#   select vault.create_secret('https://<api-host>/internal/push', 'households_push_url');
# Leave empty and reminders still arrive in the in-app inbox, just without push.
INTERNAL_PUSH_SECRET=
