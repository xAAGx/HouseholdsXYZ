{
  "name": "@households/server",
  "version": "0.0.0",
  "private": true,
  "description": "Households.xyz API: Hono on Vercel Functions.",
  "type": "module",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --clear-screen=false src/entry-node.ts",
    "build": "tsx scripts/build-vercel.ts",
    "preview": "tsx --env-file-if-exists=.env scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@households/db": "workspace:*",
    "@households/shared": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "hono": "catalog:",
    "web-push": "3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@households/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
