{
  "name": "households-xyz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@households/web --filter=@households/server",
    "dev:web": "turbo run dev --filter=@households/web",
    "dev:server": "turbo run dev --filter=@households/server",
    "dev:mobile": "turbo run dev --filter=@households/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run typecheck test && tsc -p scripts && eslint . && prettier --check .",
    "supabase": "node scripts/supabase.mjs",
    "db:new": "supabase migration new",
    "db:push": "node scripts/supabase.mjs db push",
    "db:types": "node scripts/db-types.mjs",
    "db:lint": "node scripts/supabase.mjs db lint --linked --level warning",
    "geo:import": "tsx scripts/geo-import.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@households/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fflate": "^0.8.3",
    "globals": "catalog:",
    "postgres": "^3.4.9",
    "prettier": "catalog:",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
